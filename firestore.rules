rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Interim rules (M7 to M9). Signed-in users can read the shared inventory collections, and a
    // user can read only their own profile. The only browser writes are: a shopkeeper changing a
    // product's posCount (the mock POS buttons), a shopkeeper acknowledging an open alert, and a
    // dealer moving a purchase order forward (Pending -> Accepted -> Dispatched), and a shopkeeper
    // confirming a Dispatched order as Received. Each user also owns one document of read keys for the
    // notification bell. The backend uses
    // the Admin SDK and bypasses these rules. M10 replaces this with the full role-based rule set.

    function hasRole(role) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isShopkeeper() {
      return hasRole('shopkeeper');
    }

    function isDealer() {
      return hasRole('dealer');
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /products/{productId} {
      allow update: if isShopkeeper()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posCount'])
        && request.resource.data.posCount is int
        && request.resource.data.posCount >= 0
        && request.resource.data.posCount <= 100000;
    }

    // Acknowledge: Open -> Acknowledged only, touching nothing but state and acknowledgedAt, with
    // the server's own timestamp. Creating, resolving or deleting alerts is backend-only.
    match /alerts/{alertId} {
      allow update: if isShopkeeper()
        && resource.data.state == 'Open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'acknowledgedAt'])
        && request.resource.data.state == 'Acknowledged'
        && request.resource.data.acknowledgedAt == request.time;
    }

    // Orders are created by the backend. Each role moves an order one step, touching nothing but the
    // state and that step's timestamp (the server's own time): the dealer accepts and dispatches, the
    // shopkeeper confirms receipt.
    match /purchase_orders/{orderId} {
      allow update: if
        (isDealer()
          && (
            (resource.data.state == 'Pending'
              && request.resource.data.state == 'Accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'acceptedAt'])
              && request.resource.data.acceptedAt == request.time)
            ||
            (resource.data.state == 'Accepted'
              && request.resource.data.state == 'Dispatched'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'dispatchedAt'])
              && request.resource.data.dispatchedAt == request.time)
          ))
        ||
        (isShopkeeper()
          && resource.data.state == 'Dispatched'
          && request.resource.data.state == 'Received'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'receivedAt'])
          && request.resource.data.receivedAt == request.time);
    }

    // Per-user read state for the notification bell: only the owner can read or change it, it holds
    // nothing but a capped list of keys, and it cannot be deleted.
    match /notification_reads/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['readKeys'])
        && request.resource.data.readKeys is list
        && request.resource.data.readKeys.size() <= 500;
      allow delete: if false;
    }

    match /{collection}/{document=**} {
      allow read: if request.auth != null
        && collection in ['status', 'scans', 'products', 'alerts', 'purchase_orders'];
      allow write: if false;
    }
  }
}
