# Copy to .env (gitignored). All values are optional; defaults shown.
# Detection confidence: lower catches more parts but also more false boxes on empty scenes.
CAMERA_INDEX=0
DETECTION_CONF=0.5
# Detections covering more than this share of the frame are ignored (people and rooms can score as
# parts because the model has no background class). Real parts on a shelf are far smaller.
MAX_BOX_AREA_RATIO=0.25
# Also ignored: any box whose longest side is more than this share of the frame (a sleeve or arm
# is wide but short, so the area limit alone misses it).
MAX_BOX_SIDE_RATIO=0.6
# A purchase order is raised only after this many scans in a row at or below a part's reorder level,
# so one bad frame (a hand over the camera) cannot order stock.
REORDER_CONFIRM_SCANS=2

# --- Automatic scanning (M6) ---
# The master switch. Off by default; Scan Now works either way. Run the backend as one worker.
AUTO_SCAN_ENABLED=false
# Seconds between automatic scans (at least 10).
SCAN_INTERVAL_SECONDS=60
# An automatic scan is saved to the scan history only when the counts change, or at least this often
# (a heartbeat; must not be shorter than the interval). Manual scans are always saved.
SCAN_HEARTBEAT_SECONDS=600
# A mismatch must last this long before an alert opens (a customer walking to the till with a part
# raises nothing). 0 alerts at once, for a live demo.
ALERT_DELAY_SECONDS=180
# A part must stay at or below its reorder level this long, as well as for REORDER_CONFIRM_SCANS scans
# in a row, before an order goes to the dealer (restocking or a person in front of the shelf cannot
# order). 0 with two Scan Now presses orders at once, for a live demo.
REORDER_DELAY_SECONDS=300
# Frames darker than this mean grey level (0 black to 255 white) are skipped, because a dark room reads
# as an empty shelf. 0 turns the check off. Provisional until calibrated with real frames.
MIN_FRAME_BRIGHTNESS=40
# Live testing only: made-up parts added to every scan as if the camera counted them, so the alert,
# order and Cancel flows can be tested without touching real stock (names start with zz_, e.g.
# zz_part:0). Keep it empty in normal use and at release; the backend logs a warning when it is set.
SIMULATED_PARTS=
# CORS_ORIGINS=["http://localhost:5173"]
# LOG_LEVEL=INFO
